[Icon Theme]
Name=LinuxHub Pixel
Comment=LinuxHub green overrides on the complete Tela Circle icon set
Inherits=Tela-circle,Adwaita,hicolor
Example=folder

Directories=64x64/apps,64x64/places,64x64/mimetypes,64x64/status,128x128/apps,128x128/places,128x128/mimetypes,128x128/status,256x256/apps,scalable/apps,scalable/places,scalable/mimetypes,scalable/status

[64x64/apps]
Context=Applications
Size=64
MinSize=64
MaxSize=64
Type=Fixed

[64x64/places]
Context=Places
Size=64
MinSize=64
MaxSize=64
Type=Fixed

[64x64/mimetypes]
Context=MimeTypes
Size=64
MinSize=64
MaxSize=64
Type=Fixed

[64x64/status]
Context=Status
Size=64
MinSize=64
MaxSize=64
Type=Fixed

[128x128/apps]
Context=Applications
Size=128
MinSize=128
MaxSize=128
Type=Fixed

[128x128/places]
Context=Places
Size=128
MinSize=128
MaxSize=128
Type=Fixed

[128x128/mimetypes]
Context=MimeTypes
Size=128
MinSize=128
MaxSize=128
Type=Fixed

[128x128/status]
Context=Status
Size=128
MinSize=128
MaxSize=128
Type=Fixed

[256x256/apps]
Context=Applications
Size=256
MinSize=256
MaxSize=256
Type=Fixed

[scalable/apps]
Context=Applications
Size=64
MinSize=16
MaxSize=512
Type=Scalable

[scalable/places]
